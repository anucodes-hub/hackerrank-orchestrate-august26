# Gemini API Configuration
GEMINI_API_KEY=
MODEL_NAME=gemini-1.5-flash

# Application Execution & Debug Mode
DEBUG=false
DEBUG_GEMINI=false

# Media Caching Options
ENABLE_MEDIA_CACHE=true
FORCE_REFRESH_CACHE=false

# API Timeout and Retry Settings
API_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0
RETRY_BACKOFF=2.0

# Notification Thresholds
THRESHOLD_NOTIFY=0.70
THRESHOLD_DIGEST=0.35

# Business Safety Limits
MAX_BIZ_REPORTS=5

# Quiet Hours / DND Defaults
DEFAULT_QUIET_START_HOUR=22
DEFAULT_QUIET_END_HOUR=7

# Daily Notification Fatigue Limit
FATIGUE_DAILY_LIMIT=40
